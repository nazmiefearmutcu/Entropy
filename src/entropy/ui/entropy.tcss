Screen { background: $background; color: $foreground; layout: vertical; }
#header  { height: 3; background: $surface; border: none; padding: 0 1; }
#body    { height: 1fr; layout: horizontal; }
#console { width: 32; background: $surface; border: none; padding: 0; }
#center  { width: 1fr; layout: vertical; }
#ticker  { height: 2; border: none; padding: 0; }
#hist    { height: 4; border: none; padding: 0; }
#event_hist { height: 1; border: none; padding: 0; }
#boards  { height: 1fr; layout: horizontal; }
.board-col { width: 1fr; height: 1fr; layout: vertical; }
.board-title { height: 1; color: #7a7a7a; text-style: bold; }
#boards DataTable { width: 1fr; height: 1fr; border: none; padding: 0; }
#charts  { width: 48; layout: vertical; }
#price   { height: 2fr; border: none; }
#volume  { height: 1fr; border: none; }
#quote   { height: 4; background: $surface; border: none; padding: 0 1; }
#depth   { height: auto; max-height: 14; min-height: 2; background: $surface; border: none; padding: 0 1; }
#price2  { height: 2fr; border: none; }
#volume2 { height: 1fr; border: none; }
#cmdbar  { height: 1; background: $surface; border: none; padding: 0 1; }
#status  { height: 1; background: $surface; border: none; padding: 0 1; }

/* Settings Screen styling */
/* The global `Screen { layout: vertical }` above left-aligns a modal's child,
   which parked the whole settings dialog against the left edge of a wide
   terminal. Centering happens on the SCREEN, not on the container. */
SettingsScreen {
    align: center middle;
}
#settings-container {
    width: 72;
    height: 90%;
    max-height: 48;
    background: $panel;
    border: double $primary;
    padding: 1 2;
    align: center middle;
}
#settings-title {
    width: 1fr;
    content-align: center middle;
    text-style: bold;
    color: $accent;
    height: 2;
    border-bottom: solid $primary;
}
#settings-tabs {
    height: 1fr;
}
#settings-tabs ContentSwitcher {
    height: 1fr;
}
#settings-tabs TabPane {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
}
#settings-form {
    height: 1fr;
    margin-top: 1;
    overflow-y: scroll;
}
.settings-section {
    height: 1;
    color: $accent;
    text-style: bold;
    margin-top: 1;
}
.settings-note {
    height: auto;
    color: #7a7a7a;
    margin-bottom: 1;
}
.settings-warning {
    height: auto;
    color: $warning;
    margin-bottom: 1;
}
.settings-row {
    height: 3;
    align: left middle;
}
.settings-row Label {
    width: 30;
    /* Match the row height so the text centres against a 3-row Switch/Select
       instead of sitting a line above its own control. */
    height: 3;
    color: $foreground;
    text-align: left;
    content-align: left middle;
}
.settings-row Select, .settings-row Input {
    width: 30;
}
.settings-row Switch {
    width: auto;
}
/* Collapsible indents its contents; claw the columns back so the advanced
   groups keep the same two-column shape instead of clipping their inputs. */
#settings-tabs Collapsible Contents {
    padding: 0 0 0 1;
}
#settings-tabs Collapsible .settings-row Label {
    width: 28;
}
#settings-tabs Collapsible .settings-row Select,
#settings-tabs Collapsible .settings-row Input {
    width: 28;
}
#watch-table {
    height: 10;
    border: none;
}
#watch-buttons {
    height: 3;
    align: left middle;
}
#watch-buttons Button {
    margin-right: 2;
}
#settings-buttons {
    layout: horizontal;
    height: 3;
    margin-top: 1;
    align: right middle;
}
#settings-buttons Button {
    margin-left: 2;
}

/* Help Screen styling */
HelpScreen, ErrorScreen, SearchScreen {
    align: center middle;
}
#help-body {
    width: 60;
    height: 12;
    background: $panel;
    border: double $primary;
    padding: 1 2;
    align: center middle;
    content-align: center middle;
}

/* Search Screen styling */
#search-container {
    width: 76;
    height: 70%;
    max-height: 30;
    background: $panel;
    border: double $primary;
    padding: 1 2;
}
#search-input {
    margin-bottom: 1;
}
#search-results {
    height: 1fr;
    background: $panel;
    border: none;
}

/* Error Screen styling */
#error-body {
    width: 60;
    height: 10;
    background: $panel;
    border: double $error;
    padding: 1 2;
    align: center middle;
    content-align: center middle;
    color: $error;
}

